#!/usr/bin/env bash
# Campaign supervisor: keeps autorun.sh alive AND detects an autorun that is
# alive but stuck (no heartbeat), which a plain restart loop would never notice.
#
# Detached with setsid so nothing in a shell session can take it down - a broad
# pkill while cleaning up solver processes killed the whole campaign twice on
# 2026-08-16.
#
# Start:  setsid nohup tools/fea/supervise.sh >> ~/pyg_fea/work/supervise.log 2>&1 < /dev/null &
# Stop:   touch ~/pyg_fea/work/STOP
cd /home/syaro/MikuchanRemote/Human-Pygmalion
W=/home/syaro/pyg_fea/work
HB=$W/heartbeat
STALE=2400          # 40 min without a heartbeat = stuck
mkdir -p "$W"
exec 8>/tmp/pyg_supervise.lock
flock -n 8 || { echo "supervisor already running"; exit 0; }
rm -f "$W/STOP"
log() { echo "[$(date +%m-%d\ %H:%M:%S)] supervisor: $*"; }

n=0
while [ ! -f "$W/STOP" ]; do
  n=$((n+1))
  log "starting autorun (attempt $n)"
  # NOT setsid here: the supervisor is already detached (PPID 1), and wrapping
  # the child in setsid made $! the wrapper PID, which exits immediately - the
  # supervisor then respawned autorun every 20 s and its hang detection never
  # watched the real process (only autorun's own flock kept it to one instance).
  tools/fea/autorun.sh >> "$W/autorun.log" 2>&1 &
  child=$!
  date +%s > "$HB"
  # watch the heartbeat while autorun runs
  while kill -0 "$child" 2>/dev/null; do
    sleep 120
    [ -f "$W/STOP" ] && { kill "$child" 2>/dev/null; break; }
    now=$(date +%s); hb=$(cat "$HB" 2>/dev/null || echo "$now")
    if [ $((now - hb)) -gt "$STALE" ]; then
      log "no heartbeat for $((now - hb))s - autorun is stuck, restarting it"
      # kill the whole autorun process group, then any orphaned solver
      pgid=$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')
      [ -n "$pgid" ] && kill -TERM -"$pgid" 2>/dev/null
      sleep 5
      for p in $(ps -eo pid,args | awk '/ccx -i/ && !/awk/ {print $1}'); do kill -9 "$p" 2>/dev/null; done
      break
    fi
  done
  wait "$child" 2>/dev/null
  log "autorun exited - restarting in 20 s"
  sleep 20
done
log "STOP file present, exiting"
