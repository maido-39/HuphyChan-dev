<launch>

<rosparam file="$(find 0.5Scale_HuphyChan_SIM_URDF_nohistory_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="0.5Scale_HuphyChan_SIM_URDF_nohistory" args="Revolute 9_position_controller Revolute 11_position_controller Revolute 12_position_controller Revolute 13_position_controller Revolute 14_position_controller Revolute 15_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/0.5Scale_HuphyChan_SIM_URDF_nohistory/joint_states"/>
</node>

</launch>